{
  "manifest_version": 3,
  "name": "同车余票 · AI 查票助手",
  "version": "1.0.0",
  "description": "在浏览器侧边栏查询实时铁路余票，比较直达、同车分段与中转，使用 AI 分析本轮结果。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://rail-same-train-pages.pages.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开同车余票与 AI 助手",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://rail-same-train-pages.pages.dev; object-src 'none'; base-uri 'self'; form-action 'self'"
  }
}
